# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/khivashodliktravel

# Firebase Client (Firebase Console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (Firebase Console → Service accounts → Generate new private key)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=

# App — local: http://localhost:3000 | production: https://www.khivashodliktravel.uz
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_AGENCY_EMAIL=info@khivashodliktravel.uz

# Optional: cap tour pages pre-rendered at build if Vercel times out (e.g. 40). Omit for all tours when MONGODB_URI is set at build.
# STATIC_TOUR_BUILD_LIMIT=40
NEXT_PUBLIC_WHATSAPP=998919896867
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://share.google/5eMAfjHv4OwPQduqL
NEXT_PUBLIC_GOOGLE_RATING=5.0
NEXT_PUBLIC_GOOGLE_REVIEW_COUNT=50+
NEXT_PUBLIC_TRUSTPILOT_URL=https://www.trustpilot.com
NEXT_PUBLIC_TRUSTPILOT_RATING=4.9
NEXT_PUBLIC_TRUSTPILOT_REVIEW_COUNT=30+
NEXT_PUBLIC_TRIPADVISOR_URL=https://www.tripadvisor.com
NEXT_PUBLIC_TRIPADVISOR_RATING=5.0
NEXT_PUBLIC_TRIPADVISOR_REVIEW_COUNT=40+
